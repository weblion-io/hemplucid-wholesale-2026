{% style %}
  #{{ section.id }} {
      background: {{ section.settings.color }};
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
  }
  #{{ section.id }} .wl-review-grid--wrapper {
      display: flex;
      gap: 32px;
      flex-wrap: wrap;
  }
  #{{ section.id }} .wl-review-grid--wrapper .wl-review-card {
    flex: 0 0 calc(33% - 22px);
  }
  #{{ section.id }} .wl-review-grid--wrapper .wl-review-card p.stars {
    margin-top: 16px;
    color: #002531;
    font-size: 22px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    margin-bottom: 0;
  }
  #{{ section.id }} .wl-review-grid--wrapper .wl-review-card p.review {
    color: #010101;
    font-family: var(--ambit-font-light);
    font-size: 18px;
    font-style: normal;
    font-weight: 200;
    line-height: 28px;
    margin-top: 7px;
    margin-bottom: 0;
  }
  #{{ section.id }} .wl-review-grid--wrapper .wl-review-card p.author {
    color: #010101;
    font-family: var(--ambit-font);
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 23px;
    margin-top: 5px;
    margin-bottom: 0;
  }
  
  @media only screen and (max-width: 767px) {
    #{{ section.id }} {
      margin-top: {{ section.settings.margin_top | times: 0.8 }}px;
      margin-bottom: {{ section.settings.margin_bottom  | times: 0.8 }}px;
    }
    #{{ section.id }} .container {
      max-width: 100vw;
      width: 100vw;
      margin: 0;
      padding: 0;
    }
    #{{ section.id }} .wl-review-grid--wrapper .wl-review-card {
      margin-left: 30px;
    }
    #{{ section.id }} .wl-review-grid--wrapper .slick-dots {
      display: flex;
      gap: 16px;
      margin-top: 21px;
      margin-left: auto;
      margin-right: 30px;
      width: fit-content;
    }
    #{{ section.id }} .wl-review-grid--wrapper .slick-dots > * {
        overflow: hidden;
        color: #000;
        text-align: center;
        text-overflow: ellipsis;
        font-family: var(--ambit-font);
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 150%;
        width: 17px;
    }
    #{{ section.id }} .wl-review-grid--wrapper .slick-dots .slick-active {
        border-bottom: 2px solid #C83D1B;
    }    

    #{{ section.id }} .wl-review-grid--wrapper .wl-review-card p.stars {
      margin-top: 13px;
      font-size: 19.5px;
    }
    #{{ section.id }} .wl-review-grid--wrapper .wl-review-card p.review {
      color: #010101;
      font-family: var(--ambit-font-light);
      font-size: 16px;
      line-height: 25px;
    }
    #{{ section.id }} .wl-review-grid--wrapper .wl-review-card p.author {
      font-size: 14px;
      line-height: 20px;
    }
  }
{%  endstyle %}
<section id="{{ section.id }}">
    <div class="container">
        <div class="wl-review-grid--wrapper">
            {% for block in section.blocks %}
                {% if block.type == 'card' %}
                    <div class="wl-review-card">
                        <img src="{{ block.settings.image | image_url: width: 381 }}" class="top-image" width="100%" height="auto"/>
                        <p class="stars">
                        {%- case block.settings.rating -%}
                        {%- when '5' -%}
                        ★★★★★
                        {%- when '4' -%}
                        ★★★★
                        {%- when '3' -%}
                        ★★★
                        {%- endcase -%}
                        </p>
                        <p class="review">“{{ block.settings.review }}”</p>
                        <p class="author">—{{ block.settings.author }}, Verified Buyer</p>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>
</section>
<script>
document.addEventListener("DOMContentLoaded", () => {
  if ($(window).width() < 768) {
    $('.wl-review-grid--wrapper').slick({
      responsive: [
        {
          breakpoint: 767,
          settings: {
            infinite: false,
            autoplay: false,
            arrows: false,
            slidesToScroll: 1,
            dots: true,
            slidesToShow: 1.1,
          }
        }
      ]
    });
  }
});
</script>
{% schema %}
{
  "name": "HL Reviews with Images",
  "settings": [
    {
        "type": "color",
        "id": "color",
        "label": "Background Color",
        "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 68,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 68,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 6,
      "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "select",
            "id": "rating",
            "label": "Rating",
            "options": [
                {
                    "value": "5",
                    "label": "5 Stars"
                },
                {
                    "value": "4",
                    "label": "4 Stars"
                },
                {
                    "value": "3",
                    "label": "3 Stars"
                }
            ]
        },
        {
            "type": "text",
            "id": "review",
            "label": "Review",
            "default": "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium dolor."

        },
        {
            "type": "text",
            "id": "author",
            "label": "Author",
            "default": "Darth Vader"

        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HL Reviews with Images",
      "category": "Custom"
    }
  ]
}
{% endschema %}
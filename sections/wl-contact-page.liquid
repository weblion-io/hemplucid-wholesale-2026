
<style>
    #section-id-{{ section.id }} .wl-two-col--wrapper {
        display: flex;
        gap: 2rem;
    }
    #section-id-{{ section.id }} .wl-left-col {
        display: flex;
        gap: 2rem;
        flex-direction: row;
        flex-wrap: wrap;
    }
    #section-id-{{ section.id }} .wl-left-col .text-column {
        flex: 1 1 calc(50% - 1rem);
    }

    #section-id-{{ section.id }} .wl-left-col .text-column img {
        margin-left: 0;
    }

    @media only screen and (max-width: 899px) {
        #section-id-{{ section.id }} .wl-two-col--wrapper {
            display: flex;
            flex-direction: column-reverse;
            gap: 2rem;
        }
        #section-id-{{ section.id }} .wl-left-col {
            display: flex;
            gap: 2rem;
            flex-direction: column;
            flex-wrap: wrap;
        }
        #section-id-{{ section.id }} .wl-left-col .text-column {
            flex: 0 0 calc(49% - 1rem);
        }
    }
</style>
<div id="section-id-{{ section.id }}" class="{% if section.settings.color_scheme != 'default' %}use-color-scheme use-color-scheme--{{ section.settings.color_scheme }} fully-padded-row--medium{% else %}fully-spaced-row--medium{% endif %}">

  <div class="container">
    {% if section.settings.title != blank %}
      <h2 class="hometitle h4 align-center mb-2" {%- render 'animation-attrs', attrs: 'data-cc-animate' -%}>
        {{- section.settings.title | escape -}}
      </h2>
    {% endif %}

    <div class="wl-two-col--wrapper">
        <div class="wl-left-col">
        {% for block in section.blocks %}
            <div id="block-id-{{ block.id }}" class="text-column fade-in-up" {{ block.shopify_attributes }} {%- render 'animation-attrs', attrs: animation_attrs -%}>
            {% if block.settings.enable_media %}
                <div class="text-column__image lightly-spaced-row">
                {%- if block.settings.image != blank -%}                    
                    {%- render 'image' with block.settings.image, sizes: sizes, widths: widths, size_cols_desktop: size_cols_desktop, custom_aspect_ratio: custom_media_aspect_ratio -%}
                {%- else -%}
                    <div class="placeholder-image">
                    {{- 'image' | placeholder_svg_tag: 'placeholder-svg' -}}
                    </div>
                {%- endif -%}
                </div>
            {% endif %}

            {% if block.settings.title != blank %}
                <h3 class="text-column__title h5">{{ block.settings.title | escape }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
                <div class="text-column__text rte" style="line-height: 1.1;">{{ block.settings.text }}</div>
            {% endif %}
            </div>
        {% endfor %}
        </div>
        <div class="contact__right-col">
            <script src="https://desk.zoho.com/portal/api/feedbackwidget/453456000061197027?orgId=701073393&displayType=embeded"></script>
            <div id="zsfeedbackwidgetdiv" style="z-index: 0;"></div>
        </div>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Contact Us (HL)",
  "class": "section-contact-us-hl",
  "disabled_on": {
    "groups": [
      "aside"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Contact Us (HL)"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Column",
      "settings": [
        {
          "id": "enable_media",
          "type": "checkbox",
          "label": "Enable media",
          "default": true
        },
        {
          "visible_if": "{{ block.settings.enable_media }}",
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Add a title or tagline"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share blog posts, products, or promotions with your customers. Use this text to describe products, share details on availability and style, or as a space to display recent reviews or FAQs.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Page (HL)",
      "category": "HL Custom",
      "settings": {
      },
      "blocks": [
        {
          "type": "text_block"
        },
        {
          "type": "text_block"
        },
        {
          "type": "text_block"
        }
      ]
    }
  ]
}
{% endschema %}

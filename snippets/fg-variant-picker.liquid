{% comment %}
  Parameters:
  - product {Object} - Product object.
  - current_variant {Object} - Current variant object. May be false if no variant selected.
  - product_form_id {String} - Product form ID.
  - media_ratio {Number} - Media aspect ratio.
  - block {Object} - Block object.
  - update_url {Boolean} - Whether or not to update the URL when the variant changes.
  - size_chart_link {String} - Size chart link HTML.
  - media_ratio {Number} - Aspect ratio to use for swatches.
  - swatch_style {String} - Swatch style to use for swatches.

  Dependencies:
  - Custom select component

  Usage:
  {% render 'variant-picker', product: product, product_form_id: product_form_id, block: block %}
{% endcomment %}
{%- liquid
  assign stylized_selector = false
  if product.tags contains 'stylized_selector'
    assign stylized_selector = true
  endif

  # Stylized + has Strength → hide Count and/or Size if present
  assign hide_count_option = false
  assign hide_size_option = false
  if stylized_selector
    assign option_names_dcase = product.options | join: '|' | downcase | split: '|'
    if option_names_dcase contains 'strength'
      if option_names_dcase contains 'count'
        assign hide_count_option = true
      endif
      if option_names_dcase contains 'size'
        assign hide_size_option = true
      endif
    endif
  endif
-%}
{% style %}
:root {
    --main-font-color: #002531;
}
.product-form h1.product-title {
    font-family: Ambit;
    font-size: 24px;
    font-style: normal;
    font-weight: 700;
    line-height: 30px; /* 125% */
}
.title-row {
    border-top: 3px solid var(--main-font-color);
    border-bottom: 1px solid var(--main-font-color);
    margin-top: 8px;
    margin-bottom: 8px;
}

/* Hide the "Solution" and "Scent" options (label + selectors) on all products */
.product-form .option-selector[data-option="Solution" i],
.product-form .option-selector[data-option="Scent" i] {
    display: none !important;
}

/* Hide legends visually (still read by screen readers) */
.product-form legend {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
}

{%- if stylized_selector -%}
/* Stylized: hide the "Flavor" option */
.product-form .option-selector[data-option="Flavor" i] {
    display: none !important;
}

{%- if hide_count_option -%}
/* Stylized: hide the "Count" option when the product also has "Strength" */
.product-form .option-selector[data-option="Count" i] {
    display: none !important;
}
{%- endif -%}

{%- if hide_size_option -%}
/* Stylized: hide the "Size" option when the product also has "Strength" */
.product-form .option-selector[data-option="Size" i] {
    display: none !important;
}
{%- endif -%}

/* Stylized: show the "Strength" legend */
.product-form .option-selector[data-option="Strength" i] legend {
    position: static !important;
    width: auto;
    height: auto;
    margin: 0 0 10px;
    overflow: visible;
    clip: auto;
    white-space: normal;
    padding-bottom: 8px;
}
{%- endif -%}

.input-row[data-dynamic-variant-content="variant-picker"] {
    padding-top: 8px;
}

/* ---------- Radio-style option buttons ---------- */
.product-form .option-selector[data-selector-type="listed"] .option-selector__btns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
}
.product-form .option-selector[data-selector-type="listed"] .opt-label--btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-width: 0;
    min-height: 56px;
    margin: 0;
    padding: 12px 16px;
    background: #fff;
    border: 1px solid #d9d9d9;
    border-radius: 8px;
    box-shadow: none;
    color: var(--main-font-color);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
    text-transform: none;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
}
.product-form .option-selector[data-selector-type="listed"] .opt-label--btn:hover {
    border-color: #bdbdbd;
}

/* Radio circle */
.product-form .option-selector[data-selector-type="listed"] .opt-label--btn::before {
    content: '';
    position: static;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 18px;
    height: 18px;
    border: 2px solid var(--main-font-color);
    border-radius: 50%;
    background: transparent;
    transform: none;
    opacity: 1;
}

.product-form .option-selector[data-selector-type="listed"] .opt-label--btn {
    font-size: 16px;
}

/* Selected */
.product-form .option-selector[data-selector-type="listed"] .opt-btn:checked + .opt-label--btn {
    background: #f2f2f2;
    border-color: #d9d9d9;
    color: #202020;
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
}
/* Selected radio: 2px outline ring + 10px centered dot, with a see-through gap between.
   !important guards against theme rules that thicken the border or repaint the background. */
.product-form .option-selector[data-selector-type="listed"] .opt-btn:checked + .opt-label--btn::before {
    border-width: 2px !important;
    border-style: solid !important;
    border-color: var(--main-font-color) !important;
    background-color: transparent !important;
    background-image: radial-gradient(circle at center, var(--main-font-color) 0 5px, transparent 5.5px) !important;
    background-size: 100% 100% !important;
    background-repeat: no-repeat !important;
    background-position: center !important;
    box-shadow: none !important;
    outline: 0 !important;
}

/* Keyboard focus */
.product-form .option-selector[data-selector-type="listed"] .opt-btn:focus-visible + .opt-label--btn {
    outline: 2px solid var(--main-font-color);
    outline-offset: 2px;
}

/* Unavailable */
.product-form .option-selector[data-selector-type="listed"] .opt-btn.is-unavailable + .opt-label--btn {
    opacity: 0.5;
}

.product-form .option-selector { margin-bottom: 0; }

{%- if stylized_selector -%}
/* ---------- Stylized Strength boxes ---------- */
.product-form .option-selector[data-option="Strength" i][data-selector-type="listed"] .option-selector__btns {
    /* Always 3 equal columns, so each box is 1/3 wide even with 1 or 2 options */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
}
.product-form .option-selector[data-selector-type="listed"] .opt-label--strength {
    flex-direction: column;
    justify-content: flex-start;
    gap: 10px;
    min-height: 0;
    padding: 14px 8px 14px;
    background: #fff;
    border: 1px solid #dedede;
    border-radius: 6px;
}
.product-form .option-selector[data-selector-type="listed"] .opt-label__strength-name {
    color: #202020;
    font-family: Ambit;
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    letter-spacing: normal;
    text-transform: uppercase;
}

/* mg meter (built from the design SVG; only the number is live text) */
.product-form .opt-label--strength .opt-label__gauge {
    position: relative;
    display: block;
    width: 60px;
    height: 60px;
    isolation: isolate;
}
.product-form .opt-label--strength .opt-label__gauge svg {
    display: block;
    width: 100%;
    height: 100%;
}
.product-form .opt-label--strength .opt-label__gauge-num {
    position: absolute;
    left: 0;
    right: 0;
    top: 47.6%;
    transform: translateY(-50%);
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 19px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
}

/* Radio circle moves below the gauge (ring/dot styling is shared with all radios) */
.product-form .option-selector[data-selector-type="listed"] .opt-label--strength::before {
    order: 3;
}

/* Selected: gray box, filled radio (gauge stays the same) */
.product-form .option-selector[data-selector-type="listed"] .opt-btn:checked + .opt-label--strength {
    background: #eaeaea;
    border-color: #dedede;
    font-weight: 400;
}{%- endif -%}
{% endstyle %}
{%- liquid
  assign show_variant_picker = block.settings.show_single
  if product.variants_count > 1
    assign show_variant_picker = true
  else
    for option in product.options_with_values
      if option.selected_value.product_url
        assign show_variant_picker = true
        break
      endif
    endfor
  endif
-%}

{%- if show_variant_picker -%}
  <script src="{{ 'variant-picker.js' | asset_url }}" defer></script>

  <variant-picker
      class="{% if product.available %}variant-picker--product-available{% else %}variant-picker--product-unavailable{% endif %}{% if stylized_selector %} variant-picker--stylized{% endif %}"
      data-stylized="{{ stylized_selector }}"
      data-option-count="{{ product.options_with_values | size }}"
      data-section-id="{{ section.id }}"
      data-url="{{ product.url }}"
      data-update-url="{{ update_url | default: false }}"
      data-availability="{{ block.settings.dynamic_availability }}">
    {%- for option in product.options_with_values -%}
      {%- capture option_id %}{{ product_form_id }}-{{ forloop.index }}{% endcapture -%}
      {%- liquid
        assign is_color_selector = false
        assign is_variant_image_style = false
        assign show_size_chart = false
        assign is_dropdown = false
        assign swatch_method = settings.variant_picker_color_style | default: settings.swatch_method
        assign swatch_style = swatch_style | default: settings.swatch_style

        if settings.swatch_source == 'theme' and settings.swatch_option_name contains option.name and swatch_method == 'variant-images'
          assign is_color_selector = true
          assign is_variant_image_style = true
          assign option_index0 = forloop.index0
        elsif settings.swatch_source == 'theme' and settings.swatch_option_name contains option.name and swatch_method == 'swatches'
          assign is_color_selector = true
        else
          assign native_swatch_options = option.values | where: 'swatch'
          if settings.swatch_source == 'native' and native_swatch_options.size > 0
            assign is_color_selector = true
            assign is_native_swatch_style = true
          endif
        endif

        if is_variant_image_style or is_native_swatch_style
          assign swatch_picker_image_size_x2 = settings.swatch_picker_image_size | times: 2
          assign img_sizes = settings.swatch_picker_image_size | append: 'px'
          assign img_widths = settings.swatch_picker_image_size | times: 2 | append: ', ' | append: settings.swatch_picker_image_size
          if swatch_style == 'icon_square'
            assign img_aspect_ratio = null
            assign img_crop_align = null
          else
            assign img_aspect_ratio = 1
            assign img_crop_align = settings.swatch_crop_align
          endif
        endif

        # Case 1: color selector + global dropdown
        if is_color_selector and swatch_style == 'dropdown'
          assign is_dropdown = true
        endif

        # Case 2: NOT color selector + block dropdown
        if is_color_selector == false and block.settings.selector_style == 'dropdown'
          assign is_dropdown = true
        endif

        assign block_settings_size_chart_variant_dcase_split = block.settings.size_chart_variant | split: ',' | compact
        assign option_name_dcase = option.name | downcase

        # Display label (stylized products get a custom Strength label)
        assign option_label = option.name
        if stylized_selector and option_name_dcase == 'strength'
          assign option_label = 'Choose Your CBD Strength (per dose)'
        endif

        # Stylized Strength boxes (label + mg gauge + radio)
        assign is_strength_stylized = false
        if stylized_selector and option_name_dcase == 'strength'
          assign is_strength_stylized = true
          assign strength_option_index0 = option.position | minus: 1
        endif

        if block.settings.enable_size_chart and size_chart_link != blank
          for name in block_settings_size_chart_variant_dcase_split
            assign setting_name_sanitized = name | strip | downcase
            if option_name_dcase == setting_name_sanitized
              assign show_size_chart = true
              break
            endif
          endfor
        endif
      -%}

      {%- if is_dropdown -%}
        {%- if is_variant_image_style -%}
          <style>
            {%- for value in option.values -%}
              {% liquid
                assign value_image = false
                if value.product_url != blank and value.variant != blank
                  # Combined listing
                  assign value_image = value.variant.product.featured_media
                elsif value.variant and value.variant.featured_media
                  # Variant image
                  assign value_image = value.variant.featured_media
                else
                  # Fallback for incomplete variant matrix
                  for variant in product.variants
                    if variant.options[option_index0] == value and variant.featured_media
                      assign value_image = variant.featured_media
                      break
                    endif
                  endfor
                endif
                if value_image == blank and value.swatch.image
                  assign value_image = value.swatch.image
                endif
              %}
              {%- if value_image -%}
                .option-selector-{{ option_id }} [data-swatch="{{ value | replace: '"', '' | downcase }}"] {
                  --swatch-background-color: transparent;
                  --swatch-background-image: url({{ value_image | image_url: width: 40, height: 40, crop: settings.swatch_crop_align }});
                }
              {%- elsif value.swatch.color -%}
                .option-selector-{{ option_id }} [data-swatch="{{ value | replace: '"', '' | downcase }}"] {
                  --swatch-background-color: rgb({{ value.swatch.color.rgb }});
                }
              {%- endif -%}
            {%- endfor -%}
          </style>
        {%- endif -%}
        {%- capture selector_label -%}
          <label for="{{ option_id }}-button" class="label" id="{{ option_id }}-label">{{- option_label -}}</label>
        {%- endcapture -%}
        <div class="option-selector option-selector-{{ option_id }}" data-selector-type="dropdown" data-index="{{ option.position }}" data-option="{{ option.name | escape }}">
          {%- if show_size_chart -%}
            <div class="flex justify-between">
              {{ selector_label }}
              {{ size_chart_link }}
            </div>
          {%- else -%}
            {{ selector_label }}
          {%- endif -%}
          {%- liquid
            if current_variant
              assign selected_value = option.selected_value
            else
              assign product_url_values = option.values | where: 'product_url' | where: 'selected'
              if product_url_values != empty
                assign selected_value = option.selected_value
              else
                assign selected_value = ''
              endif
            endif
          -%}
          <script src="{{ 'custom-select.js' | asset_url }}" defer></script>
          {% render 'custom-select',
            id: option_id,
            option_values: option.values,
            selected_value: selected_value,
            swatches: is_color_selector,
            native_swatches: is_native_swatch_style
          %}
        </div>
      {%- else -%}
        <fieldset class="option-selector" data-selector-type="listed" data-index="{{ option.position }}" data-option="{{ option.name | escape }}">
          {%- if show_size_chart -%}
            <div class="flex justify-between">
              <legend class="label">{{- option_label -}}</legend>
              {{ size_chart_link }}
            </div>
          {%- else -%}
            <legend class="label">{{- option_label -}}
              {% if is_color_selector -%}
                : <span class="option-selector__label-value js-color-text">
                {%- if current_variant -%}
                  {{- option.selected_value -}}
                {%- endif -%}
                </span>
              {% endif %}
            </legend>
          {%- endif -%}
          <div class="option-selector__btns flex flex-wrap">
            {%- for value in option.values -%}
              {%- liquid
                assign value_index0 = forloop.index0
                assign value_image = false

                assign try_native = false
                if settings.swatch_source == 'native'
                  assign try_native = true
                endif

                if is_variant_image_style
                  if value.product_url != blank and value.variant != blank
                    # Combined listing
                    assign value_image = value.variant.product.featured_media
                  elsif value.variant and value.variant.featured_media
                    # Variant image
                    assign value_image = value.variant.featured_media
                  else
                    # Fallback for incomplete variant matrix
                    for variant in product.variants
                      if variant.options[option_index0] == value and variant.featured_media
                        assign value_image = variant.featured_media
                        break
                      endif
                    endfor
                  endif
                  if value_image == blank
                    assign try_native = true
                  endif
                endif
              -%}

              {%- if is_strength_stylized -%}
                {%- liquid
                  # Variant for this Strength value (matches the other selected options);
                  # falls back to the first variant that has this Strength value.
                  assign strength_variant = value.variant
                  if strength_variant == blank
                    for variant in product.variants
                      if variant.options[strength_option_index0] == value
                        assign strength_variant = variant
                        break
                      endif
                    endfor
                  endif
                  assign per_serving = strength_variant.metafields.custom.per_serving.value
                  if per_serving == blank
                    assign per_serving = '01'
                  endif

                  # Box label: variant metafield custom.label, else the option value
                  assign strength_label = strength_variant.metafields.custom.label.value
                  if strength_label == blank
                    assign strength_label = value.name
                  endif

                  # Meter segments lit (of 3) follow the custom.label text: start = 1, steady = 2, strong = 3.
                  # Any other/missing label falls back to the value's position among the Strength options.
                  assign label_key = strength_label | strip | downcase
                  case label_key
                    when 'start'
                      assign gauge_lit = 1
                    when 'steady'
                      assign gauge_lit = 2
                    when 'strong'
                      assign gauge_lit = 3
                    else
                      assign gauge_lit = value_index0 | plus: 1 | times: 3.0 | divided_by: option.values.size | ceil
                  endcase
                -%}
                {%- capture label_attrs -%}class="opt-label opt-label--btn opt-label--strength btn relative text-center"{%- endcapture -%}
                {%- capture label_content -%}
                  <span class="opt-label__strength-name">{{ strength_label | escape }}</span>
                  <span class="visually-hidden js-value">{{ value.name | escape }}</span>
                  <span class="opt-label__gauge" aria-hidden="true">
                    <svg viewBox="0 0 48 48" fill="none" focusable="false">
                      {%- comment -%} Disc + darker layer with the segment/MG cut-outs (from design SVG) {%- endcomment -%}

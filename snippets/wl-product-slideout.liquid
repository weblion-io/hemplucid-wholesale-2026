{% javascript %}
  $(document).ready(function(){
    let open = false;
    $('.atc-close').on('click', function() {
        closeATCDrawer();
    });

    $('.atc-trigger').on('click', function() {
        let handle = $(this).data('handle');
        loadProduct(handle);
        setTimeout(function () {
            $('.atc-drawer--wrapper').fadeIn();
            $('.atc-drawer').animate({right: '0px'}, "fast");
            $('.atc-close').addClass('active');
            $('.atc-image-gallery').slick({
                infinite: false,
                autoplay: false,
                arrows: false,
                dots: true,
                slidesToShow: 1,
                slidesToScroll: 1
            });

        }, 500);
    });
  });

  function closeATCDrawer() {
    $('.atc-drawer').animate({right: '-440px'}, "fast");
    $('.atc-close').removeClass('active');
    $('.atc-drawer--wrapper').fadeOut();
  }

  function loadSlickTrack() {
    $('.atc-image-gallery').slick('setPosition');
  }

/* Drawer Product/Add to Cart functionality */
function formatMoney(cents, currencyCode) {
  currencyCode = currencyCode || (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
  return new Intl.NumberFormat(undefined, { style: 'currency', currency: currencyCode }).format(cents / 100);
}

function escapeHtml(str) {
  return String(str == null ? '' : str).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[c]));
}

function isArchivedVariant(variant) {
  return /\barchived\b/i.test(variant?.title || '');
}

function getActiveVariants(product) {
  return (product.variants || []).filter((v) => !isArchivedVariant(v));
}

function getDefaultVariant(product) {
  const active = getActiveVariants(product);
  return active.find((v) => v.available) || active[0] || product.variants[0];
}


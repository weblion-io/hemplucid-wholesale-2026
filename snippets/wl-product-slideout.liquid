// Which options are hidden (label + buttons). Hidden options stay in the DOM,
// checked to the default variant's value, so variant matching still works.
function isHiddenOption(nameLc, stylized, hasStrength) {
  if (nameLc === 'solution' || nameLc === 'scent') return true;      // all products
  if (stylized && nameLc === 'flavor') return true;                   // stylized products
  if (stylized && hasStrength && (nameLc === 'count' || nameLc === 'size')) return true;
  return false;
}


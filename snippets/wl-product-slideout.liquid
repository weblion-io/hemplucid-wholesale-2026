function buildGaugeSvg(litCount) {
  const lit = ATC_GAUGE_SEGMENTS.slice(0, litCount).map((d) => `<path fill="#fff" d="${d}"/>`).join('');
  return `<svg viewBox="0 0 48 48" fill="none" focusable="false">${ATC_GAUGE_BASE}${lit}${ATC_GAUGE_MG}</svg>`;
}

// Variant whose metafields describe a Strength value: the one matching the
// default variant's other options, else the first variant with that Strength.
function strengthVariantFor(activeVariants, currentVariant, index, value) {
  return activeVariants.find((v) => v.options.every((o, i) => (i === index ? o === value : o === currentVariant.options[i])))
    || activeVariants.find((v) => v.options[index] === value);
}

function buildStrengthBox(value, valueIndex, valueCount, meta) {
  const perServing = (meta && meta.per_serving) || '01';
  const label = (meta && meta.label) || value;
  const level = ATC_GAUGE_LEVELS[String(label).trim().toLowerCase()]
    || Math.ceil(((valueIndex + 1) * 3) / valueCount);

  return `
    <span class="opt-label__strength-name">${escapeHtml(label)}</span>
    <span class="visually-hidden">${escapeHtml(value)}</span>
    <span class="opt-label__gauge" aria-hidden="true">
      ${buildGaugeSvg(level)}
      <span class="opt-label__gauge-num">${escapeHtml(perServing)}</span>
    </span>
    <span class="visually-hidden">${escapeHtml(perServing)} mg</span>
  `;
}

// Builds a checkbox+label per option value, grouped by option index.
// Checkboxes behave like a single-select radio group (JS enforces exactly
// one checked checkbox per group) but keep the requested checkbox markup.
function buildVariantPicker(product, currentVariant, extras) {
  if (!product.options || product.options.length === 0 || (product.options.length === 1 && (product.options[0] === 'Title' || product.options[0].name === 'Title'))) {
    return ''; // single-variant product, no picker needed
  }

  const activeVariants = getActiveVariants(product);
  if (activeVariants.length === 0) return '';

  const variantMeta = (extras && extras.variants) || {};
  const stylized = (product.tags || []).includes('stylized_selector');
  const names = product.options.map((option) => (typeof option === 'string' ? option : option.name));
  const namesLc = names.map((n) => String(n).toLowerCase());
  const hasStrength = namesLc.includes('strength');

  return names
  .map((optionName, index) => {
    const nameLc = namesLc[index];
    const hidden = isHiddenOption(nameLc, stylized, hasStrength);
    const isStrength = stylized && nameLc === 'strength';
    const labelText = isStrength ? ATC_STRENGTH_HEADING : optionName;
    const labelId = `atc-opt-${index}-label`;

    const values = [...new Set(activeVariants.map((v) => v.options[index]))];
    const currentValue = currentVariant.options[index];

    const checkboxesHtml = values
      .map((val, valueIndex) => {
        const inputId = `atc-opt-${index}-${valueIndex}`;
        const isChecked = val === currentValue;
        const available = activeVariants.some((v) => v.options[index] === val && v.available);

        let labelClass = 'variant-option-label opt-label opt-label--btn btn relative text-center';
        let content = `<span class="js-value">${escapeHtml(val)}</span>`;
        if (isStrength) {
          const sv = strengthVariantFor(activeVariants, currentVariant, index, val);
          labelClass += ' opt-label--strength';
          content = buildStrengthBox(val, valueIndex, values.length, sv && variantMeta[sv.id]);
        }

        return `
          <input
            type="checkbox"
            class="variant-option-checkbox opt-btn visually-hidden focus-label js-option${available ? '' : ' is-unavailable'}"
            id="${inputId}"
            data-option-index="${index}"
            value="${escapeHtml(val)}"
            ${isChecked ? 'checked' : ''}
          >
          <label for="${inputId}" class="${labelClass}">${content}</label>
        `;
      })
      .join('');

    return `
      <div class="atc-opt${isStrength ? ' atc-opt--strength' : ''}" role="group" aria-labelledby="${labelId}" data-option="${escapeHtml(optionName)}" data-option-index="${index}"${hidden ? ' hidden' : ''}>
        <span class="label atc-opt__label${isStrength ? ' atc-opt__label--visible' : ' visually-hidden'}" id="${labelId}">${escapeHtml(labelText)}</span>
        <div class="variant-option-group atc-opt__btns" data-option-index="${index}">
          ${checkboxesHtml}
        </div>
      </div>
    `;
  })
  .join('');
}

function findMatchingVariant(product, selectedOptions) {
  return product.variants.find((variant) =>
    variant.options.every((val, i) => val === selectedOptions[i])
  );
}

function buildTruncatedDescription(description) {

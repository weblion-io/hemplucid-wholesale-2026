{% style %}
.atc-drawer--wrapper {
    position: fixed;
    z-index: 99998;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    background-color: rgba(255, 255, 255, 0.3); /* Semi-transparent */
    backdrop-filter: blur(10px); /* Blurs everything behind this div */
    -webkit-backdrop-filter: blur(10px); /* Webkit support (Safari) */
    display: none;
}
.atc-drawer {
    position: fixed;
    top: 0;
    right: -440px;
    bottom: 0;
    width: 440px;
    z-index: 99999;
    background: white;
    overflow-y: scroll;
    box-shadow: -10px 0 10px -5px rgba(0, 0, 0, 0.5);
}
.atc-drawer .description-content--clamped {
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.atc-drawer .atc-drawer__header {
    background: #EBE3D6;
    color: #002531;
    text-align: center;
    font-family: var(--ambit-font);
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 23px;
    text-transform: uppercase;
    padding: 1.5rem 1.5rem 1.5rem 2rem;

    display: flex;
    flex-direction: row;
    gap: auto;
    align-items: justify-between;
}
.atc-drawer .atc-drawer__content {
    padding: 0 0 0 1.8rem;
    margin-top: 0.5rem;
}
.atc-drawer .atc-drawer__content h3 {
    color: #002531;
    font-family: var(--ambit-font);
    font-size: 24px;
    font-style: normal;
    font-weight: 400;
    line-height: 26px; /* 108.333% */
}
.atc-drawer .atc-drawer__content product-form {
    flex-direction: column;
    padding-right: 1.8rem;
}
.atc-drawer .atc-drawer__content product-form.rte * {
    color: #002531;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 22px;
}
.atc-drawer .atc-drawer__title {
    flex: 1 1 100%;
    text-align: left;
}
.atc-drawer .slick-dots {
    display: flex;
    align-items: center;
    margin: auto;
    width: fit-content;
    gap: 0.8rem;
}
.atc-drawer .slick-dots li {
    height: 1rem;
    width: 1rem;
    background: #ADADAD;
    border-radius: 50%;
}
.atc-drawer .slick-dots li button { opacity: 0; }
.atc-drawer .slick-dots li.slick-active { background: #E57E3B; }
.atc-drawer .atc-image-gallery { margin-bottom: 1.8rem; }
.atc-drawer button[type="submit"].btn.add-to-cart { min-width: 100%; }
.atc-drawer form { padding-right: 1.8rem; }
.atc-drawer .slick-track { width: 100%; }
.atc-drawer .product-price { font-size: 18px; }
.atc-drawer .description-toggle { color: rgb(var(--btn-border-color)); }
@media only screen and (max-width: 767px) {
    .atc-drawer button[type="submit"].btn.add-to-cart { font-size: 16px; }
}

/* =====================================================================
   Variant options — mirrors snippets/variant-picker.liquid.
   Keep these two in sync when the picker design changes.
   ===================================================================== */
.atc-drawer {
    --main-font-color: #002531;
}
.atc-drawer .atc-opt { margin-top: 12px; }
.atc-drawer .atc-opt[hidden] { display: none !important; }

/* Option names are screen-reader only, except the stylized Strength heading */
.atc-drawer .atc-opt__label--visible {
    display: block;
    margin: 0 0 10px;
}

/* ---------- Radio-style option buttons ---------- */
.atc-drawer .atc-opt__btns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
}
.atc-drawer .atc-opt .opt-label--btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-width: 0;
    min-height: 56px;
    margin: 0;
    padding: 12px 16px;
    background: #fff;
    border: 1px solid #d9d9d9;
    border-radius: 8px;
    box-shadow: none;
    color: var(--main-font-color);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: normal;
    text-transform: none;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
}
.atc-drawer .atc-opt .opt-label--btn:hover {
    border-color: #bdbdbd;
}

/* Radio circle */
.atc-drawer .atc-opt .opt-label--btn::before {
    content: '';
    position: static;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 18px;
    height: 18px;
    border: 2px solid var(--main-font-color);
    border-radius: 50%;
    background: transparent;
    transform: none;
    opacity: 1;
}

/* Selected */
.atc-drawer .atc-opt .opt-btn:checked + .opt-label--btn {
    background: #f2f2f2;
    border-color: #d9d9d9;
    color: #202020;
    font-style: normal;
    font-weight: 500;
    line-height: normal;
}
/* Selected radio: 2px outline ring + 10px centered dot, with a see-through gap between */
.atc-drawer .atc-opt .opt-btn:checked + .opt-label--btn::before {
    border-width: 2px !important;
    border-style: solid !important;
    border-color: var(--main-font-color) !important;
    background-color: transparent !important;
    background-image: radial-gradient(circle at center, var(--main-font-color) 0 5px, transparent 5.5px) !important;
    background-size: 100% 100% !important;
    background-repeat: no-repeat !important;
    background-position: center !important;
    box-shadow: none !important;
    outline: 0 !important;
}

/* Keyboard focus */
.atc-drawer .atc-opt .opt-btn:focus-visible + .opt-label--btn {
    outline: 2px solid var(--main-font-color);
    outline-offset: 2px;
}

/* Unavailable */
.atc-drawer .atc-opt .opt-btn.is-unavailable + .opt-label--btn {
    opacity: 0.5;
}

/* ---------- Stylized Strength boxes ---------- */
.atc-drawer .atc-opt--strength .atc-opt__btns {
    /* Always 3 equal columns, so each box is 1/3 wide even with 1 or 2 options */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
}
.atc-drawer .atc-opt .opt-label--strength {
    flex-direction: column;
    justify-content: flex-start;
    gap: 10px;
    min-height: 0;
    padding: 14px 8px 14px;
    background: #fff;
    border: 1px solid #dedede;
    border-radius: 6px;
}
.atc-drawer .atc-opt .opt-label__strength-name {
    color: #202020;
    font-family: Ambit;
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: normal;
    letter-spacing: normal;
    text-transform: uppercase;
}

/* mg meter (built from the design SVG; only the number is live text) */
.atc-drawer .atc-opt .opt-label__gauge {
    position: relative;
    display: block;
    width: 60px;
    height: 60px;
    isolation: isolate;
}
.atc-drawer .atc-opt .opt-label__gauge svg {
    display: block;
    width: 100%;
    height: 100%;
}
.atc-drawer .atc-opt .opt-label__gauge-num {
    position: absolute;
    left: 0;
    right: 0;
    top: 47.6%;
    transform: translateY(-50%);
    color: #fff;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 19px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: center;
}

/* Radio circle moves below the gauge (ring/dot styling is shared with all radios) */
.atc-drawer .atc-opt .opt-label--strength::before {
    order: 3;
}

/* Selected: gray box, filled radio (gauge stays the same) */
.atc-drawer .atc-opt .opt-btn:checked + .opt-label--strength {
    background: #eaeaea;
    border-color: #dedede;
    font-weight: 400;
}
{% endstyle %}

function attachDescriptionToggle(container) {
  const wrapper = container.querySelector('.description-wrapper');
  if (!wrapper) return;

  const content = wrapper.querySelector('.description-content');
  const toggle = wrapper.querySelector('.description-toggle');

  toggle.addEventListener('click', () => {
    const isExpanded = wrapper.dataset.expanded === 'true';

    wrapper.dataset.expanded = String(!isExpanded);
    content.classList.toggle('description-content--clamped', isExpanded);
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    toggle.textContent = isExpanded ? 'Read more' : 'Read less';
  });
}

function attachDrawerEvents(container, product) {
  const checkboxes = container.querySelectorAll('.variant-option-checkbox');
  const groupIndexes = [...new Set(Array.from(checkboxes).map((cb) => cb.dataset.optionIndex))];

  checkboxes.forEach((checkbox) => {
    checkbox.addEventListener('change', () => {
      const groupIndex = checkbox.dataset.optionIndex;

      // Enforce single-selection within this option's group. Clicking the
      // label toggles the checkbox natively and fires this same 'change'
      // event, so unchecking the currently-selected box just re-checks it —
      // a variant option group should never end up with zero selections.
      if (!checkbox.checked) {
        checkbox.checked = true;
        return;
      }

      container
        .querySelectorAll(`.variant-option-checkbox[data-option-index="${groupIndex}"]`)
        .forEach((cb) => {
          if (cb !== checkbox) cb.checked = false;
        });

      // Recompute the selected value for every option group, in order
      // (hidden groups keep the default variant's value checked)
      const selectedOptions = groupIndexes.map((idx) => {
        const checked = container.querySelector(
          `.variant-option-checkbox[data-option-index="${idx}"]:checked`
        );
        return checked ? checked.value : null;
      });

      const variant = findMatchingVariant(product, selectedOptions);
      if (!variant) return;

      container.querySelector('input[name="id"]').value = variant.id;
      container.querySelector('.product-price--large').textContent = formatMoney(variant.price);

      const btn = container.querySelector('.add-to-cart');
      btn.disabled = !variant.available;
      btn.textContent = variant.available ? 'Add to cart' : 'Sold out';
    });
  });

  // Add to cart via the standard Cart AJAX API
  const form = container.querySelector('.js-product-form');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = form.querySelector('input[name="id"]').value;
    const quantity = form.querySelector('[name="quantity"]').value;

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id, quantity }] }),
      });
      if (!res.ok) throw new Error('Add to cart failed');
      // e.g. trigger your cart drawer refresh / open here
      document.dispatchEvent(new CustomEvent('cart:updated'));
      document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:refresh'));
      closeATCDrawer();
      document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:open'));
    } catch (err) {
      const errorEl = container.querySelector('.js-form-error');
      errorEl.hidden = false;
      errorEl.textContent = 'Something went wrong adding this to your cart.';
    }
  });
}

// Variant metafields (custom.label, custom.per_serving) from templates/product.atc-data.liquid.
// If that template is missing, the drawer still works: labels fall back to option values,
// numbers to '01', and meter fill to position.
async function loadDrawerExtras(handle) {
  try {
    const res = await fetch(`/products/${handle}?view=atc-data`);
    if (!res.ok) return { variants: {} };
    return JSON.parse(await res.text());
  } catch (err) {
    return { variants: {} };
  }
}

// This is the function you call from anywhere: loadProduct('some-handle')
async function loadProduct(handle) {
  const [res, extras] = await Promise.all([
    fetch(`/products/${handle}.js`),
    loadDrawerExtras(handle),
  ]);
  if (!res.ok) {
    console.error(`Product not found: ${handle}`);
    return;
  }
  const product = await res.json();

  renderProductDrawer(product, extras);
}

{% endjavascript %}

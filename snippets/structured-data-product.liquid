{%- comment -%}
  Parameters:
  - product {Object} - Product object.

  Usage:
  {% render 'structured-data-product', product: product %}
{%- endcomment -%}
{%- liquid
  # Orders at or above this amount (in cents) ship free, per the announcement bar
  assign free_shipping_threshold = 6900

  assign product_url = shop.url | append: product.url
  assign brand_name = product.vendor | default: shop.name

  if product.metafields.custom.schema_desc != blank
    assign schema_description_html = product.metafields.custom.schema_desc | metafield_text
  else
    assign schema_description_html = product.description
  endif
  capture schema_description
    render 'structured-data-text', html: schema_description_html
  endcapture
  # Google rejects descriptions longer than 5000 characters
  assign schema_description = schema_description | truncate: 5000
  assign variant_description = schema_description | truncate: 500

  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | plus: 0

  assign varies_by = ''
  for option_name in product.options
    assign option_handle = option_name | downcase
    if option_handle contains 'color' or option_handle contains 'colour'
      assign varies_by = varies_by | append: ',https://schema.org/color'
    elsif option_handle contains 'material'
      assign varies_by = varies_by | append: ',https://schema.org/material'
    elsif option_handle contains 'pattern'
      assign varies_by = varies_by | append: ',https://schema.org/pattern'
    elsif option_handle contains 'size' or option_handle contains 'count' or option_handle contains 'quantity' or option_handle contains 'pack'
      assign varies_by = varies_by | append: ',https://schema.org/size'
    endif
  endfor
  assign varies_by = varies_by | remove_first: ','
-%}

{%- capture variant_nodes -%}
  {%- for variant in product.variants -%}
    {%- liquid
      assign variant_url = product_url | append: '?variant=' | append: variant.id
      if product.has_only_default_variant
        assign variant_name = product.title
      else
        assign variant_name = product.title | append: ' - ' | append: variant.title
      endif
      assign variant_image = variant.featured_image | default: product.featured_image
      assign barcode_length = variant.barcode | size
    -%}
    {%- capture offer_json -%}
      {
        "@type": "Offer",
        "@id": {{ variant_url | append: '#offer' | json }},
        "url": {{ variant_url | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@type": "Organization", "name": {{ shop.name | json }} },
        {%- if variant.price >= free_shipping_threshold %}
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": {{ cart.currency.iso_code | json }} },
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY" },
            "transitTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 5, "unitCode": "DAY" }
          }
        },
        {%- endif %}
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "US",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 30,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn",
          "merchantReturnLink": {{ shop.url | append: '/policies/refund-policy' | json }}
        }
      }
    {%- endcapture -%}
    {
      "@type": "Product",
      "@id": {{ variant_url | append: '#variant' | json }},
      "name": {{ variant_name | json }},
      {%- if variant_description != blank %}
      "description": {{ variant_description | json }},
      {%- endif %}
      {%- if variant.sku != blank %}
      "sku": {{ variant.sku | json }},
      {%- endif %}
      {%- if barcode_length == 8 or barcode_length == 12 or barcode_length == 13 or barcode_length == 14 %}
      "gtin": {{ variant.barcode | json }},
      {%- endif %}
      {%- for option_name in product.options -%}
        {%- assign option_handle = option_name | downcase -%}
        {%- assign option_value = variant.options[forloop.index0] -%}
        {%- if option_handle contains 'color' or option_handle contains 'colour' %}
      "color": {{ option_value | json }},
        {%- elsif option_handle contains 'material' %}
      "material": {{ option_value | json }},
        {%- elsif option_handle contains 'pattern' %}
      "pattern": {{ option_value | json }},
        {%- elsif option_handle contains 'size' or option_handle contains 'count' or option_handle contains 'quantity' or option_handle contains 'pack' %}
      "size": {{ option_value | json }},
        {%- endif -%}
      {%- endfor %}
      {%- if variant_image %}
      "image": {{ variant_image | image_url: width: 1920 | prepend: 'https:' | json }},
      {%- endif %}
      "offers": {{ offer_json }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
{%- endcapture -%}

<script type="application/ld+json" id="productStructuredData">
  {
    "@context": "https://schema.org",
    "@type": "ProductGroup",
    "@id": {{ product_url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "url": {{ product_url | json }},
    "productGroupID": {{ product.id | append: '' | json }},
    "description": {{ schema_description | json }},
    {%- if product.category %}
    "category": {{ product.category.name | json }},
    {%- endif %}
    "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
    {%- if product.images.size > 0 %}
    "image": [
      {%- for image in product.images limit: 10 -%}
        {{ image | image_url: width: 1920 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    {%- endif %}
    {%- if varies_by != blank %}
    "variesBy": {{ varies_by | split: ',' | json }},
    {%- endif %}
    {%- if rating != blank and rating_count > 0 %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ rating.rating | json }},
      "reviewCount": {{ rating_count }},
      "bestRating": {{ rating.scale_max | json }},
      "worstRating": {{ rating.scale_min | json }}
    },
    {%- endif %}
    "hasVariant": [
      {{ variant_nodes }}
    ]
  }
</script>

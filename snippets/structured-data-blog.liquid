{%- comment -%}
  Blog with the posts shown on the current page.

  Parameters:
  - articles {Array} - The paginated blog.articles.

  Usage (inside {% paginate %}):
  {% render 'structured-data-blog', articles: blog.articles %}
{%- endcomment -%}
{%- liquid
  assign organization_id = shop.url | append: '/#organization'
  assign website_id = shop.url | append: '/#website'
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": {{ canonical_url | append: '#blog' | json }},
    "url": {{ canonical_url | json }},
    "name": {{ blog.title | json }},
    "isPartOf": { "@type": "WebSite", "@id": {{ website_id | json }}, "name": {{ shop.name | json }}, "url": {{ shop.url | json }} },
    "publisher": { "@id": {{ organization_id | json }} },
    "breadcrumb": { "@id": {{ canonical_url | append: '#breadcrumb' | json }} },
    "blogPost": [
      {%- for article in articles -%}
        {
          "@type": "BlogPosting",
          "@id": {{ shop.url | append: article.url | append: '#article' | json }},
          "url": {{ shop.url | append: article.url | json }},
          "headline": {{ article.title | json }},
          {%- if article.image %}
          "image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},
          {%- endif %}
          {%- if article.author != blank %}
          "author": { "@type": "Person", "name": {{ article.author | json }} },
          {%- endif %}
          "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
          "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

      "type": "collapsible-tabs",
      "blocks": {
        "question_ixgxiM": {
          "type": "question",
          "settings": {
            "title": "How can I refer a friend?",
            "answer": "<p>You can refer a friend via email or text message. Go to the <a href=\"/apps/loyalty#appstleLoyaltyPageV2ReferralSection\" title=\"Refer A Friend and Get $15\">Refer A Friend page to get started.</a></p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_WwzpBb": {
          "type": "question",
          "settings": {
            "title": "Where can I check on the status of my referrals?",
            "answer": "<p>Checking the status of your referrals is easy. Just log in and head to our <a href=\"/apps/loyalty#appstleLoyaltyPageV2ReferralSection\">Refer A Friend page</a> and scroll to the 'Transaction History' section.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_8VzAzr": {
          "type": "question",
          "settings": {
            "title": "How do I redeem my rewards from completed referrals?",
            "answer": "<p>Every time a referral is completed, you'll receive a $15 store credit. You can check your rewards balance by going to <a href=\"https://www.hemplucid.com/apps/loyalty\" title=\"https://www.hemplucid.com/apps/loyalty\">hemplucid.com/apps/loyalty</a>. You can redeem your rewards points for discounts at checkout.<br/><br/><strong>NOTE: You must be signed in to see your loyalty points.</strong></p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        }

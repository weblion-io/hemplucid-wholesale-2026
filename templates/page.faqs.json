          "type": "content",
          "settings": {
            "content": "<p>View our loyalty program details <a href=\"https://www.hemplucid.com/apps/loyalty\" title=\"https://www.hemplucid.com/apps/loyalty\">here</a>.</p>"
          }
        },
        "question_mz9tpC": {
          "type": "question",
          "settings": {
            "title": "How do I sign up for the loyalty program?",
            "answer": "<p>If you have a customer account, you're already signed up! If you don't already have a customer account, you can sign up during checkout or by going to <a href=\"https://hemplucid.com/account/register\" target=\"_blank\" title=\"Create an account and start earning today\">hemplucid.com/account/register</a>.<br/><br/>If you have issues signing up, please contact our customer service team!</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_KnwVm4": {
          "type": "question",
          "settings": {
            "title": "Where can I see my loyalty balance?",
            "answer": "<p>You can check your store credit balance by going to <a href=\"https://www.hemplucid.com/apps/loyalty\" title=\"https://www.hemplucid.com/apps/loyalty\">hemplucid.com/apps/loyalty</a>. You must be signed in to see your balance and loyalty history.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_BkKeWq": {
          "type": "question",
          "settings": {
            "title": "Can I redeem my loyalty balance on subscription products?",
            "answer": "<p>Yes! Rewards are applied as Store Credits which can be used any on purchases whether one-time orders, subscription orders, or hybrid orders.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_FDYaPH": {
          "type": "question",
          "settings": {
            "title": "Can I combine loyalty rewards with other discount codes?",
            "answer": "<p>Yes. Loyalty rewards are like cash and can be combined with discount codes.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_yxiUcU": {
          "type": "question",
          "settings": {
            "title": "How do I redeem my rewards?",
            "answer": "<p>Rewards are given as Store Credit, so applying them is as easy as clicking the checkbox on the 'Apply store credit' field at checkout.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        }
      },

    "collapsible_tabs_tgYJcW": {
      "type": "collapsible-tabs",
      "blocks": {
        "content_qzMHfT": {
          "type": "content",
          "settings": {
            "content": "<p>View our subscriptions program details <a href=\"https://hemplucid.com/pages/subscriptions\">here</a>.<br/><br/></p>"
          }
        },
        "question_7Wej3U": {
          "type": "question",
          "settings": {
            "title": "Can I earn and use loyalty points on subscription orders?",
            "answer": "<p>Can I earn and use loyalty rewards on subscription orders?</p><p>You will earn rewards with every subscription order. You can redeem loyalty rewards on your <strong>first</strong> subscription order.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_8z3Dxm": {
          "type": "question",
          "settings": {
            "title": "Do discounts or other promos apply to subscription orders?",
            "answer": "<p>No, unfortunately, discounts for recurring orders can’t be combined with other promos.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_mfKnbY": {
          "type": "question",
          "settings": {
            "title": "Is shipping free?",
            "answer": "<p>Yes! Well, mostly. First orders over $89 ship free, and <strong>all</strong> recurring orders (regardless of value) will ship free via USPS.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_cJqd7E": {
          "type": "question",
          "settings": {
            "title": "Can I upgrade my shipping method?",
            "answer": "<p>No, recurring orders will default to the USPS standard shipping.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_We7aW9": {
          "type": "question",
          "settings": {
            "title": "When will my subscription order be shipped?",
            "answer": "<p>That depends on you! Once you choose your subscription plan, you get to choose how often you want it to be sent to you. Your first order will be processed within one business day of placing it. After that, the frequency of your recurring orders and when they’re shipped will be based on your plan.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_EenUcP": {
          "type": "question",
          "settings": {
            "title": "How long does shipping take?",
            "answer": "<p>Recurring orders are shipped via USPS, and the shipping time varies depending on the distance it’s traveling from our warehouse. Typically, delivery time is 2 to 4 business days, but it could take up to 7 business days in rare cases.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_Bgyhhe": {
          "type": "question",
          "settings": {
            "title": "When will my card be charged?",
            "answer": "<p>Cards will be charged at midnight the day the order is processed. We will be sure to send an email reminder to help keep you up to date on everything surrounding your subscription.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_3KWJRG": {
          "type": "question",
          "settings": {
            "title": "Can I cancel anytime?",
            "answer": "<p>Yes. We’ll miss you though. Sign in to your HempLucid account and go into 'Subscription Management'. Locate the subscription you'd like to cancel and either </p><ol><li>Click the 'More Actions' dropdown and select 'Cancel Subscription'</li><li>Click 'See more details' and click 'Cancel Subscription'</li></ol>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_3PtQAy": {
          "type": "question",
          "settings": {
            "title": "How can I update my payment method?",
            "answer": "<p>Sign in to your HempLucid account and make the change. You’ve got the power! Sign in to your HempLucid account and click on 'Manage Subscriptions'. Once there, click on the subscription you'd like to update and navigate to the 'Payment Details' section. Click the pencil icon to be taken to your payment options. If your payment method already exists, simply select it and click 'Save'. If you need to add a new payment method, or update details on a current method, click the 'Update payment method' button. In the popup, click 'Send Email'. This will send you an email with directions on how to update or create a new payment method.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_TiRxDY": {
          "type": "question",
          "settings": {
            "title": "Can I send my subscription order to an alternate address?",
            "answer": "<p>Yes! Send it wherever you need to. Just change it in your HempLucid account by going into “Manage Subscriptions” and clicking on “Shipping Addresses.” From there, you can update or change your shipping address to have your next recurring order shipped wherever you need it to go.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        }
      },

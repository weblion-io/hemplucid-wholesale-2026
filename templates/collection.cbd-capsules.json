        "question_bmJh66": {
          "type": "question",
          "settings": {
            "title": "What is the difference between CBN and CBD?",
            "answer": "<p>While both CBD and CBN are cannabinoids, they impart different effects. CBD imparts a subtle calm and focus, while CBN is more often associated with sleepiness. While CBN appears to exhibit some pain-fighting properties, CBD is a better choice for fighting routine aches and inflammation.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_qmDymB": {
          "type": "question",
          "settings": {
            "title": "What are the benefits of CBD and CBN capsules?",
            "answer": "<p>CBD has been shown to potentially help us manage stress and anxiety, as well as addressing routine aches and strains. CBN is associated with helping us find deeper restorative sleep. When taken in capsule form, both deliver consistent, sustainable effects.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_KDgMmq": {
          "type": "question",
          "settings": {
            "title": "Is CBD or CBN better for sleep?",

    "wl_image_text_cta_za6tW4": {
      "type": "wl-image-text-cta",
      "blocks": {
        "image_ipYjV6": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/safety-quality.png",
            "bkg_color": "#595378",
            "font_color": "#ffffff",
            "tagline": "",
            "title": "Why Choose Full-Spectrum CBD?",
            "content": "<p>Full-spectrum CBD is a hemp extract that includes CBD alongside other naturally occurring plant compounds, such as minor cannabinoids and terpenes. Unlike broad-spectrum CBD, it may contain trace amounts of THC. Many customers choose full-spectrum formulas for a more complete, whole-plant hemp experience.</p>",
            "cta_text": "",
            "cta_link": ""
          }
        },
        "image_Cam9hg": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/sublingual-cbd.png",
            "bkg_color": "#ffd700",
            "font_color": "#010101",
            "tagline": "",
            "title": "Sublingual vs. Other Delivery Methods",
            "content": "<p><br/>Sublingual CBD tinctures are one of the most effective ways to take CBD, delivering hemp-derived cannabinoids through the tissues under the tongue for rapid absorption. Holding CBD oil under your tongue for 30–60 seconds before swallowing may provide a faster onset and greater bioavailability than CBD gummies, edibles, or beverages. Because sublingual CBD bypasses much of the digestive process, it allows more CBD to be absorbed and utilized by the body. As a result, CBD tinctures remain a popular option for supporting relaxation, stress management, sleep, and overall wellness.<br/><br/></p>",
            "cta_text": "",
            "cta_link": ""
          }
        },
        "image_GP3xtF": {
          "type": "image",
          "settings": {
            "image": "shopify://shop_images/focus-support.png",
            "bkg_color": "#bcd868",
            "font_color": "#010101",
            "tagline": "",
            "title": "Why Choose HempLucid?",
            "content": "<p>Customer choose HempLucid full-spectrum CBD for whole-plant hemp formulas that include CBD, naturally occurring cannabinoids, terpenes, and federally compliant trace THC. Select products are USDA Certified Organic, and every batch is supported by accessible third-party Certificates of Analysis so you can review potency and cannabinoid content with confidence. From tinctures and capsules to gummies, topicals, and water-soluble formulas, HempLucid makes it easy to find a full-spectrum CBD product that fits your everyday routine. </p>",
            "cta_text": "",
            "cta_link": ""
          }
        }
      },

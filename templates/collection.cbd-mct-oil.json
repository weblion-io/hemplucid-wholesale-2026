    "collapsible_tabs_i7rBwx": {
      "type": "collapsible-tabs",
      "blocks": {
        "question_bmJh66": {
          "type": "question",
          "settings": {
            "title": "What is broad-spectrum CBD in MCT oil?",
            "answer": "<p>Broad-spectrum CBD combines hemp-derived CBD with other naturally occurring hemp compounds, such as minor cannabinoids and terpenes, while being formulated without detectable THC. MCT oil is used as a smooth, easy-to-use carrier oil for the CBD extract.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_qmDymB": {
          "type": "question",
          "settings": {
            "title": "Why is MCT oil used in CBD tinctures?",
            "answer": "<p>MCT oil, commonly sourced from coconuts, has a mild taste and a lightweight texture that makes it a popular base for CBD tinctures. It also makes measuring and adding CBD to your daily routine simple.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_KDgMmq": {
          "type": "question",
          "settings": {
            "title": "Is broad-spectrum CBD really THC-free?",
            "answer": "<p>THC-free broad-spectrum CBD products are formulated without detectable THC. For added confidence, check out our current <a href=\"https://lucidlabs.hemplucid.com\" target=\"_blank\" title=\"https://lucidlabs.hemplucid.com\">third-party Certificate of Analysis (COA)</a> that shows the product’s cannabinoid profile and confirms THC test results.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_g4RbU6": {
          "type": "question",
          "settings": {
            "title": "Will THC-free broad-spectrum CBD make me feel high?",
            "answer": "<p>No. CBD is non-intoxicating and is not intended to produce a high. THC-free broad-spectrum CBD is designed for customers who want hemp-derived cannabinoids without THC.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_n3jn6r": {
          "type": "question",
          "settings": {
            "title": "Can THC-free CBD show up on a drug test?",
            "answer": "<p>No CBD product can guarantee a negative drug-test result. Although THC-free broad-spectrum products are made without detectable THC, testing methods, individual use, and other variables could contribute to a positive test.</p>",
            "button_txt": "",
            "link": "",
            "onclick": false,
            "onclick_code": "",
            "info": ""
          }
        },
        "question_gPAgYA": {
          "type": "question",
          "settings": {
            "title": "How much THC-free CBD oil should I take?",
            "answer": "<p>Start with the suggested serving size on the product label and adjust gradually based on your individual preferences and routine. CBD needs can vary, so consistency and careful label review are helpful when finding a serving that fits you.</p>",
